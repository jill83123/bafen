{
  "name": "bafen",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "preview:workers": "cross-env NITRO_PRESET=cloudflare_module nuxt build && wrangler dev --cwd .output",
    "postinstall": "nuxt prepare",
    "db:generate": "nuxt db generate",
    "db:migrate:local": "nuxt db migrate && wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "nuxt db migrate && wrangler d1 migrations apply DB --remote",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fancyapps/ui": "^6.1.14",
    "@libsql/client": "^0.17.3",
    "@nuxt/a11y": "^1.0.0-alpha.1",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/hints": "^1.1.2",
    "@nuxt/image": "^2.0.0",
    "@nuxt/scripts": "^1.1.1",
    "@nuxt/ui": "^4.8.0",
    "@nuxthub/core": "^0.10.7",
    "@unhead/vue": "^2.1.15",
    "@vee-validate/nuxt": "^5.0.0-beta.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.4.0",
    "jose": "^6.2.3",
    "ms": "^2.1.3",
    "nuxt": "^4.4.6",
    "nuxt-security": "^2.6.0",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7",
    "vue3-google-login": "^2.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/ms": "^2.1.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.1",
    "wrangler": "^4.94.0"
  }
}
