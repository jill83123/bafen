{
  "name": "bafen",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:lan": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "preview:workers": "cross-env NITRO_PRESET=cloudflare_module nuxt build && wrangler dev --cwd .output",
    "postinstall": "nuxt prepare",
    "db:generate": "nuxt db generate",
    "db:migrate:local": "nuxt db migrate && wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "nuxt db migrate && wrangler d1 migrations apply DB --env staging --remote",
    "db:migrate:production": "nuxt db migrate && wrangler d1 migrations apply DB --env production --remote",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/chiron-hei-hk": "^5.3.1",
    "@libsql/client": "^0.17.4",
    "@nuxt/a11y": "^1.0.0-alpha.1",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/hints": "^1.1.4",
    "@nuxt/image": "^2.1.0",
    "@nuxt/scripts": "^1.3.2",
    "@nuxt/ui": "^4.10.0",
    "@nuxthub/core": "^0.10.8",
    "@nuxtjs/robots": "^6.1.3",
    "@nuxtjs/sitemap": "^8.3.1",
    "@unhead/vue": "^2.1.16",
    "@unovis/ts": "^1.6.7",
    "@unovis/vue": "^1.6.7",
    "@vueuse/integrations": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "browser-image-compression": "^2.0.2",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.8.0",
    "gsap": "^3.15.0",
    "image-size": "^2.0.2",
    "jose": "^6.2.5",
    "ms": "^2.1.3",
    "nuxt": "^4.5.1",
    "nuxt-schema-org": "^6.2.8",
    "nuxt-security": "^2.6.0",
    "photoswipe": "^5.4.4",
    "sortablejs": "^1.15.7",
    "swiper": "^12.2.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vue3-google-login": "^2.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/lsicon": "^1.2.5",
    "@iconify-json/lucide": "^1.2.120",
    "@iconify-json/material-symbols": "^1.2.87",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ri": "^1.2.10",
    "@types/ms": "^2.1.0",
    "@types/sortablejs": "^1.15.9",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eruda": "^3.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "schema-dts": "^2.0.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.8",
    "wrangler": "^4.115.0"
  }
}
